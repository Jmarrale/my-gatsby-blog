# Copy to ".env" for local Supabase development, or set these in your host's
# dashboard (Vercel/Netlify) for production. NEVER commit real values.
#
# Leave VITE_DATA_MODE unset (or "local") to run the app on in-browser sample
# data with no backend — great for demos and previews.

# "local" (default) or "supabase"
VITE_DATA_MODE=local

# Only needed when VITE_DATA_MODE=supabase.
# Find these in Supabase → Project Settings → API.
# The anon key is safe to expose in the browser; Row-Level Security protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
